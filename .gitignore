########################################
# Doxygen & Sphinx generated content
########################################

docs/build/
docs/doxygen/
docs/source/api/
latex/

# Written by the regression runner on every run
regression/report.html

# Written by ErrorMessages next to the case that produced it
# Templates written by the generators in utilities/inputExample/. Scoped to that folder:
# input_settings.txt and friends are real, tracked inputs everywhere else.
utilities/inputExample/*.txt

# SCIANTIX run artefacts: regenerated on every execution, never meant to be committed
error_log.txt
input_check.txt
execution.txt
overview.txt



########################################
# Python
########################################

__pycache__/
*.pyc


########################################
# Editors / IDEs
########################################

#doxygen
latex

# Folders
bin/
obj/
build/
out/
documentation/
.vscode/
.vs/

########################################
# OS / misc junk
########################################

*.bak
.DS_Store
Testing/


########################################
# Project-specific
########################################

bin/
out/
# Figures are regenerable artefacts, not documentation: every regression group writes
# its plots into <group>/figures/ and plotter.sh rebuilds the lot. Nothing under a
# figures/ directory is meant to be committed.
*.png
old_files/
__pycache__/
optimization
GSA_output_files/

# Generated files in driver
driver/sciantix_driver
driver/output.txt
driver/overview.txt
sciantix_driver
output.txt
overview.txt
main

# Other files to ignore
*.json

# Temporary data dump file
filename.csv

# Data files from running sciantix. If you need input files back, restore from test_inputs/default
test_input/execution.txt
test_input/input_check.txt
test_input/input_history.txt
test_input/input_initial_conditions.txt
test_input/input_scaling_factors.txt
test_input/input_settings.txt
test_input/output.txt
test_input/overview.txt

# Regression test output files
regression/*/output.txt

